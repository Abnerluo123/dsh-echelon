{
  "name": "dsh-echelon",
  "version": "1.3.0",
  "description": "Echelon for DeepSeek Harness: name a few tiers, and each one becomes an ordered chain of real models with retries, failover, reasoning-level translation, context-window routing and vision routing. 挡位式模型路由：按命名选模型，失败自动降级。",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "echelon",
    "model-router",
    "model-cascading",
    "sequential-fallback",
    "failover",
    "multi-provider",
    "load-balancing",
    "rate-limit",
    "429",
    "reasoning-effort",
    "vision-routing",
    "llm"
  ],
  "files": [
    "index.js",
    "client.js",
    "src",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "node": ">=22.14.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "scripts": {
    "test": "node --test test/",
    "verify": "node scripts/verify-profile.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abnerluo123/dsh-echelon.git"
  },
  "homepage": "https://github.com/Abnerluo123/dsh-echelon#readme",
  "bugs": {
    "url": "https://github.com/Abnerluo123/dsh-echelon/issues"
  }
}
